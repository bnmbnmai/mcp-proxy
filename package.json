{
  "name": "@apollo_ai/mcp-proxy",
  "version": "4.10.0",
  "description": "BNM Data Shop — official public-data x402 GETs at ticks.bnm.farm",
  "type": "module",
  "bin": {
    "apollo-proxy-mcp": "build/index.js"
  },
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/ticks-ams-leftovers.js build/aaib-reports.js",
    "prepare": "npm run build",
    "start": "node build/index.js",
    "sync:live-shop": "node scripts/sync-live-shop.mjs",
    "collect:ticks-ams-leftovers": "node build/ticks-ams-leftovers.js",
    "collect:aaib-reports": "node build/aaib-reports.js",
    "test:shop-catalog": "node build/shop-catalog.test.js",
    "test:ticks-ams-leftovers": "node build/ticks-ams-leftovers.test.js",
    "test:aaib-reports": "node build/aaib-reports.test.js",
    "test": "npm run test:shop-catalog && npm run test:ticks-ams-leftovers && npm run test:aaib-reports"
  },
  "files": [
    "build",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "micropayments",
    "usdc",
    "base",
    "official-data"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bnmbnmai/mcp-proxy.git"
  },
  "homepage": "https://ticks.bnm.farm",
  "bugs": {
    "url": "https://github.com/bnmbnmai/mcp-proxy/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "mcp": {
    "name": "io.github.bnmbnmai/bnm-data-shop",
    "url": "https://ticks.bnm.farm/mcp",
    "transport": "streamable-http"
  },
  "mcpName": "io.github.bnmbnmai/bnm-data-shop"
}
